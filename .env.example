# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# better-auth — required
BETTER_AUTH_URL="http://localhost:3000"
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret"

# OAuth providers — all optional. A provider is only enabled server-side when
# both its ID and secret are set; the login page still shows all three
# buttons, so signing in with an unconfigured provider will fail.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Extra trusted origins for better-auth, comma-separated (BETTER_AUTH_URL's
# own origin is already trusted automatically — only add e.g. a local
# /etc/hosts dev alias here if you use one). Also used for Next.js
# allowedDevOrigins in dev (localhost is always allowed).
TRUSTED_ORIGINS=

# Optional — enables the AI character-generation feature.
OPENAI_API_KEY=
