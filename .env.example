# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# better-auth — required
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret"

# OAuth providers — all optional. Leave a pair unset to disable that
# provider's sign-in button; only configure the ones you actually need.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Extra trusted origins for better-auth, comma-separated (BETTER_AUTH_URL's
# own origin is already trusted automatically — only add e.g. a local
# /etc/hosts dev alias here if you use one).
TRUSTED_ORIGINS=

# Optional — enables the AI character-generation feature.
OPENAI_API_KEY=
